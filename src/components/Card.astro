---
interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
  tags?: string[];
  badge?: string;
}

const { href, title, description, meta, tags = [], badge } = Astro.props;
---

<a class="card" href={href}>
  <div class="top">
    {meta && <span class="eyebrow">{meta}</span>}
    {badge && <span class="badge">{badge}</span>}
  </div>
  <h3>{title}</h3>
  <p class="muted">{description}</p>
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.2rem;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  p {
    margin: 0;
    font-size: 0.95rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-ink);
    background: var(--accent-soft);
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
  }
</style>
