---
// Embeds a deployed app so visitors can use it live without leaving the page.
// The target site must allow framing (no `X-Frame-Options: DENY` / restrictive `frame-ancestors`).
interface Props {
  url: string;
  title: string;
  height?: number;
}

const { url, title, height = 600 } = Astro.props;
const host = new URL(url).host;
---

<figure class="demo">
  <div class="chrome">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="url">{host}</span>
    <a href={url} target="_blank" rel="noopener">Open in new tab ↗</a>
  </div>
  <iframe
    src={url}
    title={`Live demo: ${title}`}
    loading="lazy"
    style={`height:${height}px`}
    sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
  ></iframe>
</figure>

<style>
  .demo {
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 0.85rem;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }
  .url {
    flex: 1;
    font-family: var(--font-mono);
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  iframe {
    display: block;
    width: 100%;
    max-height: 80vh;
    border: 0;
    background: #fff;
  }
</style>
