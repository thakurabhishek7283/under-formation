---
import { AUTHOR, SOCIALS } from '../consts';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---

<footer>
  <div class="container row">
    <span class="muted">© {year} {AUTHOR.name}</span>
    <nav aria-label="Social">
      {SOCIALS.map((s) => <a href={s.href} rel="me noopener" target="_blank">{s.label}</a>)}
      <a href={`mailto:${AUTHOR.email}`}>Email</a>
      <a href={url('/rss.xml')}>RSS</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding-block: 1.5rem;
    font-size: 0.9rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--text-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
  }
</style>
