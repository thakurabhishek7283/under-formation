const listingCode = `// 1. Write the DISPLAY source and tag lines with trailing markers.
export const MY_CODE = listing(\`
  function f(a, lo, hi) {                     //@ fn
    if (lo >= hi) return;   // 1 item: done   //@ base
    const mid = (lo + hi) >> 1;               //@ mid
  }
\`);

// 2. Every recorded step names a marker and the variables in scope there.
rec.push('Split the range in half.', { line: 'mid', vars: { lo, hi, mid } });

// 3. The panel highlights that line and diffs vars against the previous step.
<CodePanel listing={MY_CODE} cursor={step.code}
           previous={player.steps[player.index - 1]?.code} />`;

const determinismCode = `import { rng } from '../../lib/ml/math';
import { pct, r1 } from './num';

// Seeded, so the build machine and the browser produce the same "random" weights.
const r = rng(42);

// Rounded, so the numbers serialize identically on both sides.
<div style={{ width: pct(count / total) }} />
<circle cx={r1(x)} cy={r1(y)} />

// A fixed first array; randomize only in response to a click.
const [input, setInput] = useState(() =>
  Array.from({ length: n }, (_, i) => ((i * 37 + 11) % 89) + 8));`;

const playerCode = `const player = usePlayer<MyStep>(steps);         // play / pause / seek / speed
useEffect(() => player.load(steps), [steps]);   // params changed -> new trace
player.load(next, true);                        // after an op: replace + autoplay

<PlayerControls player={player} message={player.step.message} />`;

const splitCode = `<div className="viz-split">
  <div>{/* the visual */}</div>
  <CodePanel listing={MY_CODE} cursor={step.code}
             previous={player.steps[player.index - 1]?.code} title="merge sort" />
</div>`;

const treeCode = `src/
  consts.ts              name, tagline, email, socials, nav links
  content.config.ts      the three collection schemas (Zod)

  content/
    blog/                *.md|mdx  -> /blog/<name>/
    projects/            *.md|mdx  -> /projects/<name>/
    visualizations/      *.mdx     -> /visualize/<name>/   (22 pages)

  lib/                   PURE TYPESCRIPT — zero React imports
    content.ts           getPosts / getProjects / getVisualizations + draft filter
    code.ts              listing() markers + tokenize() for the code panel
    algorithms/          sorting, segmentTree, fenwickTree, kmp,
                         bloomFilter, hyperLogLog, hash
