const schemaCode = `const visualizations = defineCollection({
  loader: glob({ base: './src/content/visualizations', pattern: '**/*.{md,mdx}' }),
  schema: z.object({
    title: z.string(),
    description: z.string(),
    pubDate: z.coerce.date(),
    // Groups cards on /visualize, e.g. "Probabilistic data structures".
    category: z.string(),
    tags: z.array(z.string()).default([]),
    draft: z.boolean().default(false),
  }),
});`;

const routeCode = `export async function getStaticPaths() {
  const viz = await getVisualizations();          // sorted, drafts filtered
  return viz.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);          // the MDX body, as a component
---
<ArticleLayout title={entry.data.title} eyebrow={entry.data.category} ...>
  <Content />
</ArticleLayout>`;

const draftCode = `// Drafts are visible in \`npm run dev\` but excluded from production builds.
const visible = ({ data }) => import.meta.env.DEV || !data.draft;`;

const algoCode = `// src/lib/algorithms/countMinSketch.ts  —  plain TypeScript, no React

import { listing, type CodeCursor } from '../code';

export interface CmsStep {
  counters: number[][];
  message: string;      // narration shown under the transport controls
  code: CodeCursor;     // which listing line this step is executing
}

export const CMS_CODE = listing(\`
  function add(item, counters) {              //@ fn
    for (let r = 0; r < d; r++) {             //@ loop
      const c = hash(item, r) % w;            //@ hash
      counters[r][c]++;                       //@ bump
    }
  }
\`);

export function addSteps(cms, item): CmsStep[] {
  const steps: CmsStep[] = [];
  const push = (message, code) =>
    steps.push({ counters: cms.counters.map((r) => [...r]), message, code });

  push('Hash the item once per row.', { line: 'fn', vars: { item } });
  for (let r = 0; r < cms.d; r++) {
    const c = hash(item, r) % cms.w;
    push('Row ' + r + ' lands in column ' + c + '.', { line: 'hash', vars: { r, c } });
    cms.counters[r][c]++;
    push('Bump that counter.', { line: 'bump', vars: { r, c } });
  }
  return steps;
}`;

const islandCode = `// src/components/viz/CountMinSketchViz.tsx  —  the React island

import { useMemo, useState } from 'react';
import { CMS_CODE, addSteps, build, type CmsStep } from '../../lib/algorithms/countMinSketch';
import { usePlayer } from './usePlayer';
import { PlayerControls } from './PlayerControls';
import { CodePanel } from './CodePanel';
import { Stat } from './Stat';
import './viz.css';

export default function CountMinSketchViz({ width = 16, depth = 4 }) {
  const [item, setItem] = useState('alice');
  const steps = useMemo(() => addSteps(build(width, depth), item), [width, depth, item]);
  const player = usePlayer<CmsStep>(steps);
  const step = player.step;

  return (
    <div className="viz" aria-label="Count-min sketch visualization">
      <div className="viz-row">
        <input className="input mono" value={item} onChange={(e) => setItem(e.target.value)} />
      </div>

      <div className="viz-split">
        <div>{/* the picture: viz-cells / viz-cell, SVG, bars ... */}</div>
        <CodePanel
          listing={CMS_CODE}
          cursor={step.code}
          previous={player.steps[player.index - 1]?.code}
          title="add(item)"
        />
      </div>

      <PlayerControls player={player} message={step.message} />

      <div className="viz-stats">
        <Stat k="Rows" v={String(depth)} />
        <Stat k="Width" v={String(width)} />
      </div>
    </div>
  );
}`;

const mdxCode = `---
